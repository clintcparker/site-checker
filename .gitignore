# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Ignore docs/ contents, but keep docs/how-to/ tracked. The exact shape matters:
# git will not re-include a file whose parent directory is excluded, so this must
# exclude the directory's *contents* (docs/*) rather than the directory itself.
docs/*
!docs/how-to/
# Spec Kit runtime state (run logs and catalog cache; config and workflows stay tracked)
/.specify/workflows/runs/
/.specify/workflows/.cache/
__pycache__/
*.py[cod]
# Local worktree path for the in-flight feature — machine-specific, never shareable.
/.specify/feature.json

# Spec-kit process exhaust. The spec documents themselves (spec/plan/tasks/research/
# data-model/quickstart/contracts/checklists, plus reviews/ and qa/qa-*.md) stay
# tracked and are linked from CHANGELOG.md; what follows is machine output that only
# means anything on the machine that produced it.
specs/*/releases/
specs/*/qa/responses/
specs/*/screenshots/
specs/*/qa/screenshots/
# specs/*/.spec-context.json
src-tauri/Site Checker App Icon.zip
/.playwright-mcp/
